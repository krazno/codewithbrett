{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/ursuline-ai-assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/artifacts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/ursuline-ai",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/ursuline-ai/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/ursuline-ai/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/ursuline", "destination": "/ursuline-ai/", "permanent": true },
    { "source": "/ursuline/", "destination": "/ursuline-ai/", "permanent": true },
    { "source": "/ursuline-ai", "destination": "/ursuline-ai/", "permanent": true },
    { "source": "/ursuline-ai/faculty", "destination": "/ursuline-ai/#faculty", "permanent": true },
    { "source": "/ursuline-ai/faculty/", "destination": "/ursuline-ai/#faculty", "permanent": true },
    { "source": "/student", "destination": "/", "permanent": true },
    { "source": "/student/", "destination": "/", "permanent": true },
    { "source": "/class", "destination": "/", "permanent": true },
    { "source": "/class/", "destination": "/", "permanent": true }
  ]
}
